<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="kulathoor.net.xml"/>
        <route-files value="kulathoor.rou.xml"/>
    </input>

    <time>
        <begin value="1000"/>
        <end value="1800"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
        <collision.action value="warn"/>
        <lateral-resolution value="0.3"/>
    </processing>

    <output>
        <fcd-output value="kulathoor_fcd.xml"/>
        <tripinfo-output value="kulathoor_tripinfo.xml"/>
        <summary-output value="kulathoor_summary.xml"/>
    </output>

    <report>
        <verbose value="true"/>
    </report>

</configuration>