<?xml version="1.0" encoding="UTF-8"?>
<configuration>

   <input>
        <net-file value="test.net.xml"/>
        <route-files value="test.rou.xml"/>
    </input>

    <time>
        <begin value="1000"/>
        <end value="1600"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
        <collision.action value="warn"/>
        <lateral-resolution value="0.3"/>
    </processing>

    <output>
        <fcd-output value="test_fcd.xml"/>
        <tripinfo-output value="test_tripinfo.xml"/>
        <summary-output value="test_summary.xml"/>
    </output>

    <report>
        <verbose value="true"/>
    </report>

</configuration>


